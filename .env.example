GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Reserved for upcoming adapters; not consumed by current AgentHub settings.
OPENROUTER_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/agenthub
REDIS_URL=redis://localhost:56379/0
LLM_PROVIDER=gemini
LLM_MODEL=models/gemini-2.5-flash
EMBEDDING_MODEL=models/embedding-001
SEMANTIC_CACHE_ENABLED=true
# Keep fallback disabled for the free demo.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
# MCP_SERVERS=[{"name":"local","url":"http://127.0.0.1:8014/mcp/sse"}]

# Signed admission and durable AI processing; reply publication/delivery are pending.
TELEGRAM_AI_ENABLED=false
TELEGRAM_AI_PROVIDER=groq
TELEGRAM_AI_MODEL=
WEBHOOK_INTERNAL_URL=
WEBHOOK_AGENT_INGRESS_KEY=
WEBHOOK_AGENT_SERVICE_KEY=
AGENT_WEBHOOK_REPLY_KEY=
# Tenant-authorized metadata reads; independent of inference workers.
PLATFORM_READ_ENABLED=false
AUTHFORTRESS_BASE_URL=
